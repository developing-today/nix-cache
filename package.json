{
  "name": "nix-cache",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nix binary cache on Cloudflare: Workers + R2 + KV + D1 + Queues + Cron",
  "scripts": {
    "build": "cf build",
    "dev": "wrangler dev",
    "schema": "wrangler d1 execute nix-cache-db --remote --file schema.sql",
    "typecheck": "tsc --noEmit",
    "version:upload": "cf workers versions create"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261121.1",
    "cf": "1.0.0-rc.2",
    "typescript": "^5.6.0",
    "wrangler": "4.166.0"
  }
}
